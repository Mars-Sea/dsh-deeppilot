// Regenerates tests/fixtures/auth-vectors.json, the single cross-language
// contract for the protocol-v2 authentication proof (PROTOCOL.md, auth.prove).
//
// Both the TypeScript Host (tests/auth-vectors.test.ts) and the iOS app
// (app-private/ios/Tests/AuthVectorTests.swift) read this file, so the
// canonical string and the signature encoding cannot drift apart silently.
//
// The file holds two independent signers over the same canonical strings:
//   node  - Node's crypto, what tests/auth-fixture.ts uses
//   swift - CryptoKit, the layout the real app emits (needs macOS + swift)
//
// Run only when the canonical form changes on purpose. Regeneration draws new
// throwaway keys, so every signature in the file changes; commit the result
// together with the matching Swift mirror change.
//   npx tsx scripts/gen-auth-vectors.mts
import { execFileSync } from 'node:child_process'
import { generateKeyPairSync, sign } from 'node:crypto'
import { writeFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import { canonicalAuthChallenge, type AuthProofFields } from '../src/device-auth.ts'

interface Case {
  name: string
  fields: AuthProofFields
}

const nonce = 'n'.repeat(32)
const base = { nonce, audience: 'deeppilot:test', issuedAt: 1_000, expiresAt: 31_000 }

// Each case pins one way the encoding could diverge between languages.
const cases: Case[] = [
  { name: 'ascii-no-cursor', fields: { ...base, deviceId: 'device', deviceName: 'iPhone', appVersion: '2.0' } },
  { name: 'cursor-zero-is-not-absent', fields: { ...base, deviceId: 'device', deviceName: 'iPhone', appVersion: '2.0', resumeCursor: 0 } },
  { name: 'cursor-42', fields: { ...base, deviceId: 'device', deviceName: 'Mars iPhone', appVersion: '2.0', resumeCursor: 42 } },
  { name: 'cjk-and-emoji-name', fields: { ...base, deviceId: 'device', deviceName: '马尔斯的 iPhone 📱', appVersion: '2.0.1 (build 7)' } },
  // Control characters and the field separators must not be able to forge a
  // neighbouring field: text fields are base64url-encoded before joining.
  { name: 'separator-injection-in-name', fields: { ...base, deviceId: 'device', deviceName: 'a\nresume-cursor:1\nb:c', appVersion: '2.0' } },
  {
    name: 'epoch-millis-and-max-safe-cursor',
    fields: {
      ...base, deviceId: 'ZGV2aWNlLWlk', deviceName: 'iPhone', appVersion: '2.0',
      issuedAt: 1_760_000_000_000, expiresAt: 1_760_000_030_000, resumeCursor: Number.MAX_SAFE_INTEGER,
    },
  },
]

const canonicals = cases.map((item) => ({ name: item.name, canonical: canonicalAuthChallenge(item.fields).toString('utf8') }))

const nodeKey = generateKeyPairSync('ec', { namedCurve: 'prime256v1' })
const jwk = nodeKey.publicKey.export({ format: 'jwk' })
const nodePublicKey = Buffer.concat([
  Buffer.from([0x04]),
  Buffer.from(jwk.x!, 'base64url'),
  Buffer.from(jwk.y!, 'base64url'),
]).toString('base64url')

const swiftScript = fileURLToPath(new URL('./sign-auth-vectors.swift', import.meta.url))
const swiftOut = JSON.parse(execFileSync('swift', [swiftScript], {
  input: JSON.stringify({ cases: canonicals }),
  encoding: 'utf8',
})) as { publicKey: string; signatures: Array<{ name: string; signature: string }> }

const fixture = {
  comment: 'Generated by scripts/gen-auth-vectors.mts - do not edit by hand. Consumed by tests/auth-vectors.test.ts and the iOS AuthVectorTests.',
  cases: cases.map((item, index) => ({
    name: item.name,
    fields: item.fields,
    canonical: canonicals[index]!.canonical,
  })),
  signers: {
    node: {
      publicKey: nodePublicKey,
      signatures: Object.fromEntries(canonicals.map((item) => [
        item.name,
        sign('sha256', Buffer.from(item.canonical, 'utf8'), nodeKey.privateKey).toString('base64url'),
      ])),
    },
    swift: {
      publicKey: swiftOut.publicKey,
      signatures: Object.fromEntries(swiftOut.signatures.map((item) => [item.name, item.signature])),
    },
  },
}

const target = fileURLToPath(new URL('../tests/fixtures/auth-vectors.json', import.meta.url))
writeFileSync(target, JSON.stringify(fixture, null, 2) + '\n')
console.log(`wrote ${target} (${cases.length} cases, 2 signers)`)
